{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build && pnpm build-storybook --quiet -o dist/storybook",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/sandbox/", "permanent": false }]
}
